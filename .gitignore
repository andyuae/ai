# ===== 绝不能上传 GitHub 的敏感内容 =====

# 数据库文件（含加密的 API 密钥和历史对话）
backend/data/
backend/test-data/
*.db
*.db-shm
*.db-wal

# 环境变量文件（含加密钥匙）
.env
.env.local
.env.*.local
# 但示例文件要提交，供别人知道有哪些变量
!.env.example

# 日志和临时文件
*.log
server.log
tmp/

# ===== 冗余内容 =====

# 依赖包（体积巨大，上传无意义）
node_modules/

# 构建产物：由 GitHub Actions 在云端构建，不再提交
dist/
# 历史上的产物目录，已废弃（防止旧脚本/误操作又把产物提交进来）
docs/
